      "permanent": true
    },
    {
      "source": "/interop/node/call-javascript",
      "destination": "/interop/bridge/import-and-calls",
      "permanent": true
    },
    {
      "source": "/interop/typescript-runtime",
      "destination": "/interop/bridge/import-and-calls",
      "permanent": true
    },
    {
      "source": "/interop/bridge/call-javascript",
      "destination": "/interop/bridge/import-and-calls",
      "permanent": true
    },
    {
      "source": "/interop/bridge/import-and-setup",
      "destination": "/interop/bridge/import-and-calls",
      "permanent": true
    },
    {
      "source": "/interop/bridge/sync-async-generators",
