package main

import "fmt"

// Void body + ensure infers Result(Void, Error) -> Go `func() error`.
// Golden: ../out/result_void_ensure.go
error NeedFailed {reason: String}

func need(ok Bool) {
	ensure ok is True()
	    else NeedFailed({reason: "need failed"})
}

func run(ok Bool) {
	err := need(ok)
	ensure err is Ok()
	return 1
}

func main() {
	r := run(true)
	ensure r is Ok()
	fmt.Println(r)
}
