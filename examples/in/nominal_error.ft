package main

import "fmt"

// Nominal error type (RFC 02): `error Name { ... }` introduces a named failure kind with a
// struct payload. It is not a plain `type` alias; the compiler ties it to the built-in `Error`
// for typing and interop. Payload fields use the same record shape as an ordinary struct type.
// Also covers bare ensure on a bound void Result (assign then ensure) when the failure path
// needs the value.
// Golden: ../out/nominal_error.go
error NotPositive {message: String}

func Test() {
	n := 0
	ensure n is GreaterThan(0)
	    else NotPositive({message: "n must be greater than 0"})
}

func main() {
	result := Test()
	ensure result else {
		fmt.Println(result)
	}
}
