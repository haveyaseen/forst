{
  "compiler": {
    "target": "go",
    "optimization": "debug",
    "strict": false,
    "reportPhases": false,
    "reportMemoryUsage": false
  },
  "files": {
    "include": ["**/*.ft", "**/*.ts"],
    "exclude": [
      "**/node_modules/**",
      "**/.git/**"
    ],
    "maxDepth": 10
  },
  "bridge": {
    "enabled": true,
    "importPolicy": "explicit",
    "runtimeEnabled": true
  }
}
