package main

import "fmt"

// Bool ensure uses the True() constraint (not a bare bool or `is true`).
error FlagFail {reason: String}

func checkFlag(ok Bool): Result(String, Error) {
	ensure ok is True()
	    else FlagFail{reason: "flag was false"}
	return "ok"
}

func main() {
	r := checkFlag(true)
	ensure r is Ok()
	fmt.Println(r)
}
