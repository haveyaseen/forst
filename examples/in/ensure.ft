package main

import "fmt"

// ensure with Min/LessThan and typed failure errors.
// Golden: ../out/ensure/ensure.go
error TooShort {message: String}

error TooFast {message: String}

func mustBeARealName(name String) {
	ensure name is Min(1)
	    else TooShort{message: "Name must be at least 1 character long"}
}

func mustNotExceedSpeedLimit(speed Int) {
	ensure speed is LessThan(100)
	    else TooFast{message: "Speed must not exceed 100 km/h"}
}

func checkConditions() {
	ensure mustBeARealName("John")
	speed := 80
	ensure mustNotExceedSpeedLimit(speed)
	return 20
}

func main() {
	result := checkConditions()
	ensure result is Ok() else {
		fmt.Printf("Conditions not met: %s", result.Error())
		fmt.Println()
	}
	fmt.Printf("Conditions met (value %d), program exiting successfully", result)
	fmt.Println()
}
