{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Forst",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.png",
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "dark-plus"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "why"
            ]
          },
          {
            "group": "Getting started",
            "pages": [
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Language",
            "pages": [
              "language/overview",
              {
                "group": "Validate data",
                "pages": [
                  "language/shapes-and-constraints",
                  "language/check-a-value",
                  "language/name-a-rule",
                  "language/union-and-intersection-types"
                ]
              },
              {
                "group": "Handle failure",
                "pages": [
                  "language/named-errors",
                  "language/result"
                ]
              },
              {
                "group": "Share services",
                "pages": [
                  "language/providers"
                ]
              }
            ]
          },
          {
            "group": "Interoperability",
            "pages": [
              "interop/go",
              {
                "group": "Call Forst from JavaScript",
                "root": "interop/invoke",
                "pages": [
                  "interop/invoke/generate-types",
                  "interop/invoke/call-forst",
                  "interop/invoke/security",
                  "interop/invoke/testing",
                  "interop/invoke/effect"
                ]
              },
              {
                "group": "Call JavaScript from Forst",
                "root": "interop/bridge",
                "pages": [
                  "interop/bridge/import-and-calls",
                  "interop/bridge/build-and-runtime",
                  "interop/bridge/security"
                ]
              }
            ]
          },
          {
            "group": "Workflow",
            "pages": [
              "workflow/cli",
              "workflow/dev-server",
              "workflow/plugins",
              "workflow/editor"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Project",
            "pages": [
              "resources/llms",
              "resources/roadmap"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "For agents",
          "href": "/resources/llms",
          "icon": "robot"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/forst-lang/forst",
          "icon": "github"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/package/@forst/cli",
          "icon": "npm"
        },
        {
          "anchor": "Roadmap",
          "href": "https://github.com/forst-lang/forst/blob/main/ROADMAP.md",
          "icon": "map"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/icon.png",
    "dark": "/logo/icon.png"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/forst-lang/forst"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/forst-lang/forst"
    }
  },
  "redirects": [
    {
      "source": "/language/ensure-and-narrowing",
      "destination": "/language/check-a-value",
      "permanent": true
    },
    {
      "source": "/language/type-guards",
      "destination": "/language/name-a-rule",
      "permanent": true
    },
    {
      "source": "/language/errors-and-result",
      "destination": "/language/named-errors",
      "permanent": true
    },
    {
      "source": "/interop/node",
      "destination": "/interop/invoke",
      "permanent": true
    },
    {
